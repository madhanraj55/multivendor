# BharatBazaar Frontend Environment Variables
# Base URL of the NestJS backend API (including or excluding /api/v1 global prefix)
# Local development:
# VITE_API_URL=http://localhost:3000/api/v1
# Mobile testing via Cloudflare Tunnel:
# VITE_API_URL=https://<your-backend-tunnel-id>.trycloudflare.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1
