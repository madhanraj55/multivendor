# Application Environment Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL 18.6)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/multiecom?schema=public"

# Authentication Secrets (Generate strong random secrets in production)
JWT_ACCESS_SECRET="your-jwt-access-secret-change-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRATION="7d"

# Frontend Application URLs (CORS & Email links)
FRONTEND_URL="http://localhost:5173"

# Public Storage / Backend URL (used for serving uploads and public assets)
# In development: http://localhost:3000
# In production: https://api.yourdomain.com or https://cdn.yourdomain.com
APP_URL="http://localhost:3000"
STORAGE_PUBLIC_URL="http://localhost:3000/uploads"

# Brevo Transactional Email API Configuration
BREVO_API_KEY="your-brevo-api-key-here"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="BharatBazaar"

