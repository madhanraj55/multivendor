# Application Environment Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL 18.6)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/multiecom?schema=public"

# Authentication Secrets (Generate strong random secrets in production)
JWT_ACCESS_SECRET="your-jwt-access-secret-change-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRATION="7d"

# Frontend Application URLs (CORS & Email links)
FRONTEND_URL="http://localhost:5173"
